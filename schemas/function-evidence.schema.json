{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dishonored-re/function-evidence.schema.json",
  "title": "Dishonored function evidence record",
  "description": "Build-specific function identity and separate analysis, semantic, graph, and runtime evidence states.",
  "type": "object",
  "required": ["record_version", "build", "function", "analysis", "claims", "edges", "runtime"],
  "properties": {
    "record_version": { "const": 1 },
    "build": {
      "type": "object",
      "required": ["app_id", "build_id", "executable_sha256", "image_base"],
      "properties": {
        "app_id": { "type": "string", "minLength": 1 },
        "build_id": { "type": "string", "minLength": 1 },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "image_base": { "$ref": "#/$defs/address" }
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": ["module", "va", "rva", "size_bytes", "name", "index_source", "index_sha256"],
      "properties": {
        "module": { "type": "string", "minLength": 1 },
        "va": { "$ref": "#/$defs/address" },
        "rva": { "$ref": "#/$defs/address" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "signature": { "type": "string" },
        "index_source": { "type": "string", "minLength": 1 },
        "index_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "tool", "tool_version", "status", "input_sha256", "source_ref", "cache_key"],
        "properties": {
          "kind": { "enum": ["decompile", "manual_body_review", "callgraph", "xref", "strings", "vtable", "dataflow", "runtime_trace", "other"] },
          "tool": { "type": "string", "minLength": 1 },
          "tool_version": { "type": ["string", "null"] },
          "status": { "enum": ["complete", "partial", "failed", "not_run"] },
          "input_sha256": { "$ref": "#/$defs/sha256" },
          "options_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "source_ref": { "type": "string", "minLength": 1 },
          "source_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "cache_key": { "$ref": "#/$defs/sha256" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "claim_status", "statement", "evidence", "build_sha256"],
        "properties": {
          "kind": { "enum": ["role", "owner", "field_read", "field_write", "side_effect", "dataflow", "runtime_behavior", "other"] },
          "claim_status": { "enum": ["confirmed", "observed", "inferred", "unknown", "superseded", "rejected"] },
          "statement": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "build_sha256": { "$ref": "#/$defs/sha256" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_ref", "source_kind"],
              "properties": {
                "source_ref": { "type": "string", "minLength": 1 },
                "source_kind": { "enum": ["experiment", "file", "tool_output", "runtime_capture", "analyst_note"] },
                "source_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
                "va": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
                "rva": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
                "pointer_provenance": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_module", "target_va", "kind", "claim_status", "evidence_ref", "build_sha256"],
        "properties": {
          "target_module": { "type": "string", "minLength": 1 },
          "target_va": { "$ref": "#/$defs/address" },
          "kind": { "enum": ["direct_call", "virtual_dispatch", "dataflow", "ownership", "xref", "other"] },
          "claim_status": { "enum": ["confirmed", "observed", "inferred", "unknown", "superseded", "rejected"] },
          "evidence_ref": { "type": "string", "minLength": 1 },
          "build_sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "runtime": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "claim_status", "baseline_id", "capture_ref", "build_sha256"],
        "properties": {
          "status": { "enum": ["not_run", "observed", "replicated", "failed", "blocked"] },
          "claim_status": { "enum": ["confirmed", "observed", "inferred", "unknown", "superseded", "rejected"] },
          "baseline_id": { "type": "string", "minLength": 1 },
          "capture_ref": { "type": "string", "minLength": 1 },
          "capture_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "build_sha256": { "$ref": "#/$defs/sha256" },
          "inputs": { "type": "string" },
          "outputs": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "address": { "type": "string", "pattern": "^0x[A-Fa-f0-9]{8,16}$" }
  },
  "additionalProperties": false
}
